{
	"name": "admd-games",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"engines": {
		"node": ">=24 <25",
		"npm": ">=11"
	},
	"packageManager": "npm@11.19.0",
	"scripts": {
		"prepare": "simple-git-hooks && npm run prepare -w web",
		"setup": "npm install && npm run setup -w web",
		"dev": "npm run dev -w web",
		"build": "npm run build --workspaces --if-present",
		"check": "npm run check --workspaces --if-present",
		"lint": "npm run lint --workspaces --if-present && node scripts/check-boundaries.mjs",
		"format": "npm run format --workspaces --if-present",
		"test": "npm run test --workspaces --if-present",
		"verify": "npm run lint && npm run check && npm run test && npm run knip && npm run build && npm run size",
		"knip": "knip",
		"size": "node scripts/check-worker-size.mjs"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"esbuild@0.25.12": true,
		"esbuild@0.18.20": true,
		"workerd@1.20261116.1": true,
		"workerd@1.20261117.1": true
	},
	"devDependencies": {
		"knip": "^6.46.1",
		"simple-git-hooks": "^2.14.0"
	},
	"simple-git-hooks": {
		"pre-commit": "node scripts/pre-commit.mjs",
		"commit-msg": "node scripts/check-commit-msg.mjs $1",
		"pre-push": "node scripts/pre-push.mjs"
	}
}
