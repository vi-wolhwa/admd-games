{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "admd-games",
	"compatibility_date": "2026-11-20",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "admd-games",
			// 로컬 개발은 이 값과 무관하게 .wrangler/ 아래 SQLite 파일을 쓴다.
			// 실제 ID 는 Actions 의 'cloudflare-bootstrap' 을 한 번 실행해 받아 넣는다(docs/operations.md).
			"database_id": "3c8e9066-24e1-4896-91d6-e6e9b0ac051d",
			"migrations_dir": "migrations"
		}
	],
	"env": {
		// PR 미리보기 전용 — 운영 Worker · 운영 D1 과 완전히 분리(setup-agenda 6-4).
		// 같은 Worker 의 미리보기 주소는 운영 D1 에 연결되는 함정이 있어 Worker 자체를 나눈다.
		"preview": {
			"name": "admd-games-preview",
			"workers_dev": true,
			"preview_urls": true,
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "admd-games-preview",
					"database_id": "37ba1709-3e2b-4b88-8f37-e7e2a8e9ff72",
					"migrations_dir": "migrations"
				}
			]
		}
	}
}
