{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"types": ["$app/types", "node", "./worker-configuration.d.ts"],
		"checkJs": false
	},
	"include": [
		"src",
		"scripts/*.ts",
		".storybook/*.ts",
		"vite.config.ts",
		"prettier.config.js",
		"eslint.config.js",
		"drizzle.config.ts"
	]
}
